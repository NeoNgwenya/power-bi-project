table 'Run Log'
	lineageTag: 7b2f4678-8966-42ec-9237-8d21c35acf0e

	/// Counts all sync attempts in the current filter context.
	measure 'Total Runs' = COALESCE(COUNTROWS('Run Log'), 0)
		formatString: #,0
		lineageTag: 60ceedc5-012c-4882-afed-e778a9d54552

	/// Counts attempts with the normalized Failed status.
	measure 'Failed Runs' = CALCULATE([Total Runs], KEEPFILTERS('Run Log'[Status] = "Failed"))
		formatString: #,0
		lineageTag: 8843e2e1-e732-4647-a46a-ca61b75ce350

	/// Divides failed runs by all runs in the same filter context. Returns blank if there were no runs.
	measure 'Failure Rate' = DIVIDE([Failed Runs], [Total Runs])
		formatString: 0.0%
		lineageTag: f8cfa52d-b695-4fbe-a1ac-98b2e17aaf28

	column 'Run ID'
		dataType: string
		isHidden
		lineageTag: 46153eb1-aec6-4909-bb4a-d6486d2842df
		summarizeBy: none
		sourceColumn: Run ID

	column 'Run Date'
		dataType: dateTime
		formatString: dd MMM yyyy
		lineageTag: b4916945-5372-4949-8acb-a759e1615677
		summarizeBy: none
		sourceColumn: Run Date

		annotation UnderlyingDateTimeDataType = Date

	column 'Route ID'
		dataType: string
		isHidden
		lineageTag: e9a1eac2-1ee2-45ac-90b7-ab3af3bf96e1
		summarizeBy: none
		sourceColumn: Route ID

	column Status
		dataType: string
		lineageTag: c5f4062c-4d62-4e26-8f9c-55af57775ce6
		summarizeBy: none
		sourceColumn: Status

	partition 'Run Log' = m
		mode: import
		source =
				let
				    CsvBytes = Binary.Decompress(Binary.FromText("", BinaryEncoding.Base64), Compression.Deflate),
				    Source = Csv.Document(CsvBytes, [Delimiter=",", Columns=4, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Normalized = Table.TransformColumns(Headers, {{"Run ID", Text.Trim, type text}, {"Route ID", each Text.Upper(Text.Trim(_)), type text}, {"Status", each Text.Proper(Text.Trim(_), "en-US"), type text}}),
				    Clean = Table.TransformColumns(Normalized, {{"Run Date", each Date.FromText(_, [Format="yyyy-MM-dd", Culture="en-US"]), type date}})
				in
				    Clean

